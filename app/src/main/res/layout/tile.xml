<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="215dp" android:padding="10dp"
    android:focusable="true" android:clickable="true">
    <LinearLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:duplicateParentState="true" android:background="@drawable/tile_bg"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="@drawable/logo_bg" android:padding="8dp">
            <ImageView android:id="@+id/logo" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter"/>
            <TextView android:id="@+id/number" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|left" android:textColor="#FF333333" android:textSize="20sp" android:textStyle="bold"/>
        </FrameLayout>
        <TextView android:id="@+id/ar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFFFF" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFB8C4D6" android:textSize="16sp"/>
    </LinearLayout>
</FrameLayout>
